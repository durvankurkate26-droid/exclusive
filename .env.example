# ---------------------------------------------------------------------------
# EXCLUSIVE — environment
# Copy to `.env.local` and fill in. `.env*` is gitignored; never commit real keys.
# Values come from: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public: where Supabase sends users back after OAuth / email confirmation.
# Must exactly match the Site URL + Redirect URLs configured in Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ and never import them into a
# client component. They bypass Row Level Security entirely.
# Only needed to APPLY MIGRATIONS and RUN THE DEMO SEED from your machine.
# ---------------------------------------------------------------------------

# Postgres connection string (Dashboard > Project Settings > Database > Connection string > URI).
# Used by `npm run db:push`.
SUPABASE_DB_URL=

# Service-role key (Dashboard > Project Settings > API > service_role).
# Used by `npm run db:seed` to create the demo accounts.
SUPABASE_SERVICE_ROLE_KEY=
